APP_NAME=Tappy
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=/Users/prinnce/Documents/php/tappy/database/database.sqlite
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Airtime/data top-up provider: fake | reloadly | dingconnect | dtone
# (also selectable from Admin → System Settings → Integrations)
PROVIDER_DRIVER=reloadly
# Optional read-path fallback (operator detection) — sends stay on the primary.
PROVIDER_FALLBACK_DRIVER=

RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_SANDBOX=false
RELOADLY_WEBHOOK_SECRET=

DINGCONNECT_API_KEY=
DINGCONNECT_SANDBOX=true

DTONE_API_KEY=
DTONE_API_SECRET=
DTONE_SANDBOX=true

# Gift-card provider: defaults to the top-up driver when unset.
# fake | reloadly | tremendous | tillo | giftbit | tango
GIFTCARD_DRIVER=
GIFTCARD_FALLBACK_DRIVER=

TREMENDOUS_API_KEY=
TREMENDOUS_SANDBOX=true

TILLO_API_KEY=
TILLO_SECRET=
TILLO_SECTOR=marketplace
TILLO_SANDBOX=true

GIFTBIT_API_KEY=
GIFTBIT_SANDBOX=true

TANGO_PLATFORM_NAME=
TANGO_PLATFORM_KEY=
TANGO_ACCOUNT_IDENTIFIER=
TANGO_CUSTOMER_IDENTIFIER=
TANGO_SANDBOX=true

VITE_APP_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=

PAYMENT_DRIVER=stripe
